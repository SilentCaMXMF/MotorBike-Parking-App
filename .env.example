# API Configuration
DEV_API_BASE_URL=http://localhost:3000
STAGING_API_BASE_URL=http://staging.example.com
PROD_API_BASE_URL=http://your-raspberry-pi-ip:3000
API_TIMEOUT=30000

# Environment (development, staging, production)
ENVIRONMENT=development

# Google Maps API Key for web
# Get your key at: https://console.cloud.google.com/google/maps-apis/
# Enable "Maps JavaScript API" and optionally "Places API"
GOOGLE_MAPS_API_KEY=
